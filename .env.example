# Vercel Marketplace의 Neon 연결로 설정됩니다.
DATABASE_URL=
# 서버 전용. .env.local에 보관하고 GitHub에 올리지 않습니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 예약 정리 인증. Production 서버 전용, 32자 이상의 임의 값.
CRON_SECRET=

# 앱 전역 AI 운영 예산(USD). 일/월은 UTC 기준, 0은 AI 중단.
# 잘못된 값·지원하지 않는 모델·원장 오류는 기본 힌트로 전환합니다.
AI_DAILY_BUDGET_USD=1
AI_MONTHLY_BUDGET_USD=10
